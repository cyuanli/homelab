# Home PC Configuration  
# Copy this file to home-pc.env.local and customize for your setup

# VPS configuration
VPS_HOSTNAME=my-vps
VPS_IP=

# Tailscale configuration (optional - if not set, manual auth required)
TAILSCALE_AUTHKEY=

# Docker configuration
DOCKER_USER=

# Traefik configuration
TRAEFIK_DIR=~/traefik
SERVICES_DIR=./services
