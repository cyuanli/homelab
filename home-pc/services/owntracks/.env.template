# OwnTracks Environment Variables Template
# Copy this file to .env and set your actual values

# Domain for your OwnTracks instance
DOMAIN=your-domain.com

# HTTP Basic Auth users for OwnTracks frontend
# Generate with: ./setup-auth.sh
# Format: username:$2y$10$hashedpassword
OWNTRACKS_AUTH_USERS=admin:$$2y$$10$$YOUR_BCRYPT_HASH_HERE