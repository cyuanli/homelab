# VPS Configuration
# Copy this file to vps.env.local and customize for your setup

# Home PC configuration
HOME_PC_NAME=cyl-homelab

# Tailscale configuration (optional - if not set, manual auth required)
TAILSCALE_AUTHKEY=

# SSH public key for VPS access (optional - if not set, will prompt)
SSH_PUBLIC_KEY=

# Nginx configuration
NGINX_TEMPLATE_PATH=nginx/nginx.conf.template
