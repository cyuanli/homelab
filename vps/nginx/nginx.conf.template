load_module modules/ngx_stream_module.so;

user www-data;
worker_processes auto;
pid /run/nginx.pid;

events { worker_connections 1024; }

stream {
  log_format basic '$remote_addr [$time_local] '
                   '$protocol $status $bytes_sent $bytes_received '
                   '$session_time "$upstream_addr"';

  access_log /var/log/nginx/stream_access.log basic;
  error_log  /var/log/nginx/stream_error.log warn;

  upstream traefik_https {
{{UPSTREAM_HTTPS}}
  }

  upstream traefik_http3 {
{{UPSTREAM_HTTP3}}
  }

  upstream traefik_http {
{{UPSTREAM_HTTP}}
  }

  upstream ssh_backend {
{{UPSTREAM_SSH}}
  }

  upstream minecraft_backend {
{{UPSTREAM_MINECRAFT}}
  }

  server {
    listen 443;
    listen [::]:443;
    proxy_pass traefik_https;
    proxy_protocol on;
    proxy_connect_timeout 5s;
    proxy_timeout 60s;
  }

  server {
    listen 443 udp;
    listen [::]:443 udp;
    proxy_pass traefik_http3;
    proxy_connect_timeout 5s;
    proxy_timeout 60s;
  }

  server {
    listen 80;
    listen [::]:80;
    proxy_pass traefik_http;
    proxy_protocol on;
    proxy_connect_timeout 5s;
    proxy_timeout 60s;
  }

  server {
    listen 51422;
    listen [::]:51422;
    proxy_pass ssh_backend;
    proxy_connect_timeout 5s;
    proxy_timeout 10m;
  }

  server {
    listen 25565;
    listen [::]:25565;
    proxy_pass minecraft_backend;
    proxy_connect_timeout 5s;
    proxy_timeout 30m;
  }
}

