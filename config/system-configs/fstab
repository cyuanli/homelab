# noforget + inodecalc=path-hash keep NFS file handles valid across a remount,
# preventing a cluster-wide stale-handle cascade. Needs mergerfs >= 2.41.
# Superseded by mergerfs-media.service. If that unit is enabled, comment this
# line out or the pool gets double-mounted.
/mnt/data1:/mnt/data2:/mnt/data3:/mnt/data4 /media/data mergerfs defaults,noatime,direct_io,minfreespace=51G,category.create=epmfs,moveonenospc=true,noforget,inodecalc=path-hash 0 0

# NFSv4 needs a single export root with fsid=0.
/media/data /exports/media none bind 0 0
/srv/app-storage /exports/configs none bind 0 0
/media/data/games /exports/games none bind 0 0
