# Homelab Configuration Template
# Copy this file to homelab.env and customize for your environment

# =======================
# BASIC CONFIGURATION
# =======================

# Domain and networking
DOMAIN="cliff.li"
ACME_EMAIL="cyl@cliff.li"

# User configuration
HOMELAB_USER="cyl"
HOMELAB_UID="1000"
HOMELAB_GID="1000"

# =======================
# TAILSCALE CONFIGURATION
# =======================

# Tailscale authentication key (get from https://login.tailscale.com/admin/settings/keys)
TAILSCALE_AUTHKEY=""

# VPS configuration (for hybrid setups)
VPS_HOSTNAME=""
VPS_IP=""

# =======================
# STORAGE CONFIGURATION
# =======================

# Main data directory (for media, backups, etc.)
DATA_ROOT="/media/data"

# Media directories
MEDIA_MOVIES="${DATA_ROOT}/media/movies"
MEDIA_TV="${DATA_ROOT}/media/tv"
MEDIA_MUSIC="${DATA_ROOT}/media/music"
DOWNLOADS_DIR="${DATA_ROOT}/downloads"

# Kubernetes persistent volume storage
K8S_STORAGE_ROOT="/opt/k3s-storage"

# =======================
# K3S CONFIGURATION
# =======================

# K3s version to install
K3S_VERSION="v1.28.8+k3s1"
KUBECTL_VERSION="v1.28.8"

# Node role (server or agent)
NODE_ROLE="server"

# Cluster token (auto-generated for first server, required for additional nodes)
CLUSTER_TOKEN=""

# Server URL (required for agent nodes)
SERVER_URL=""

# =======================
# SERVICE CONFIGURATION
# =======================

# Container user/group IDs
PUID="${HOMELAB_UID}"
PGID="${HOMELAB_GID}"
TIMEZONE="Etc/UTC"

# Service versions
TRAEFIK_VERSION="v3.0"
NEXTCLOUD_VERSION="latest"
JELLYFIN_VERSION="latest"
QBITTORRENT_VERSION="latest"
PROWLARR_VERSION="latest"
SONARR_VERSION="latest"
RADARR_VERSION="latest"

# Feature flags
ENABLE_TRAEFIK_DASHBOARD="true"
ENABLE_LOCATION_SERVICES="false"
ENABLE_DISK_MONITORING="true"
ENABLE_BACKUP_MONITORING="true"

# =======================
# MONITORING & NOTIFICATIONS
# =======================

# Discord webhook for alerts (optional)
DISCORD_WEBHOOK_URL=""

# Disk monitoring configuration
DISK_MONITOR_INTERVAL="5"  # minutes
DISK_MONITOR_WEBHOOK="${DISCORD_WEBHOOK_URL}"

# Backup monitoring
BORGMATIC_WEBHOOK_URL="${DISCORD_WEBHOOK_URL}"

# =======================
# ADVANCED CONFIGURATION
# =======================

# Let's Encrypt configuration
LETSENCRYPT_STAGING="false"

# Backup retention
BACKUP_RETENTION_DAYS="30"

# UFW firewall configuration
ENABLE_UFW="true"
ALLOW_SSH_FROM_LAN="true"
LAN_CIDR="192.168.0.0/16"