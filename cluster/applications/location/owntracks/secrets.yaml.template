apiVersion: v1
kind: Secret
metadata:
  name: owntracks-auth
  namespace: location
type: Opaque
stringData:
  # Basic auth users for OwnTracks frontend
  # Format: username:$apr1$hash
  # Generate with: htpasswd -nbm username password
  users: "username1:$apr1$CHANGEME$hashedpassword1,username2:$apr1$CHANGEME$hashedpassword2"
