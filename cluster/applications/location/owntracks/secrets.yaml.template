apiVersion: v1
kind: Secret
metadata:
  name: owntracks-auth
  namespace: location
type: Opaque
stringData:
  # Basic auth users for OwnTracks frontend
  # Format: username:$2y$10$hashedpassword
  # Generate with: htpasswd -nbm username password
  # Or use: scripts/setup-auth.sh owntracks username password location
  users: "username1:$apr1$CHANGEME$hashedpassword1,username2:$apr1$CHANGEME$hashedpassword2"