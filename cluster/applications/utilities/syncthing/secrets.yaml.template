# Copy this file to secrets.yaml and fill in the git remote URL.
# The URL should include authentication, e.g.:
#   https://<token>@github.com/user/repo.git
#
# Then apply with: kubectl apply -f secrets.yaml
#
# DO NOT commit secrets.yaml to git.
apiVersion: v1
kind: Secret
metadata:
  name: syncthing-git
  namespace: utilities
type: Opaque
stringData:
  GIT_REMOTE_URL: "https://YOUR_TOKEN@github.com/YOUR_USER/YOUR_REPO.git"
