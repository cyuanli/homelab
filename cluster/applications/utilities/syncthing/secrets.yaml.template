# Copy to secrets.yaml, fill in the git remote URL with an embedded token
# (https://<token>@github.com/user/repo.git), then kubectl apply it.
# DO NOT commit secrets.yaml.
apiVersion: v1
kind: Secret
metadata:
  name: syncthing-git
  namespace: utilities
type: Opaque
stringData:
  GIT_REMOTE_URL: "https://YOUR_TOKEN@github.com/YOUR_USER/YOUR_REPO.git"
