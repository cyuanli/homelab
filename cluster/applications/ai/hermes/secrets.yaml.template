apiVersion: v1
kind: Secret
metadata:
  name: hermes-env
  namespace: ai
type: Opaque
stringData:
  MATRIX_HOMESERVER: "https://matrix.org"
  # Token and device_id from the /login API (see README), not Element, so logging out of Element doesn't kill it
  MATRIX_ACCESS_TOKEN: "CHANGEME"
  MATRIX_DEVICE_ID: "CHANGEME"
  # Bot account's recovery key, from Element > Settings > Security > Set up Secure Backup
  MATRIX_RECOVERY_KEY: "CHANGEME"
  # Comma-separated Matrix user IDs
  MATRIX_ALLOWED_USERS: "@CHANGEME:matrix.org"
