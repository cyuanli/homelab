# Homelab Configuration Template for cyl-mitx
# Copy to config.env.local and customize with your secrets

# =======================
# BASIC CONFIGURATION
# =======================

# Domain and networking
DOMAIN="cliff.li"
ACME_EMAIL="cyl@cliff.li"

# User configuration
HOMELAB_USER="cyl"
HOMELAB_UID="1000"
HOMELAB_GID="1000"

# =======================
# K3S CONFIGURATION
# =======================

# Node role and cluster info
NODE_ROLE=server
CLUSTER_TOKEN=REPLACE_WITH_CLUSTER_TOKEN
SERVER_URL=REPLACE_WITH_SERVER_URL

# K3s version
K3S_VERSION="v1.33.5+k3s1"
KUBECTL_VERSION="v1.33.5"

# =======================
# TAILSCALE CONFIGURATION
# =======================

# Tailscale authentication key
TAILSCALE_AUTHKEY=REPLACE_WITH_YOUR_TAILSCALE_AUTHKEY

# =======================
# STORAGE CONFIGURATION
# =======================

# Storage configuration (inherited from main cluster)
DATA_ROOT="/media/data"
K8S_STORAGE_ROOT="/opt/k3s-storage"

# =======================
# SERVICE CONFIGURATION
# =======================

# Container user/group IDs
PUID="1000"
PGID="1000"
TIMEZONE="Etc/UTC"

# Feature flags
ENABLE_TRAEFIK_DASHBOARD="false"
ENABLE_LOCATION_SERVICES="false"
ENABLE_DISK_MONITORING="true"
ENABLE_BACKUP_MONITORING="true"

# =======================
# MONITORING & NOTIFICATIONS
# =======================


# =======================
# KUBELET CONFIGURATION
# =======================

# Resource reservations for system and Kubernetes components
# This node has 12 CPUs and 16GB RAM
# CPU: Reserving 2 cores (1 system + 1 K8s) out of 12 cores via CPU pinning
#      CPUs 0-1: Reserved for system (kubelet, etcd, containerd, OS, network drivers)
#      CPUs 2-11: Available for pods (10 CPUs allocatable)
# Memory: Reserving 2GB total (1.5GB system + 500Mi K8s) out of 16GB
#         Leaves ~14GB allocatable for workloads
KUBELET_SYSTEM_RESERVED_CPU="1"
KUBELET_SYSTEM_RESERVED_MEMORY="1.5Gi"
KUBELET_KUBE_RESERVED_CPU="1"
KUBELET_KUBE_RESERVED_MEMORY="500Mi"

# CPU Manager Policy: static enables CPU pinning for Guaranteed QoS pods
# Pods with integer CPU requests==limits get exclusive CPU cores
# Reserved CPUs (system-reserved + kube-reserved = 2) are never allocated to pods
KUBELET_CPU_MANAGER_POLICY="static"

# =======================
# ADVANCED CONFIGURATION
# =======================

# UFW firewall configuration
ENABLE_UFW="true"
ALLOW_SSH_FROM_LAN="true"
LAN_CIDR="192.168.0.0/16"
