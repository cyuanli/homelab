NODE_ROLE=server
CLUSTER_TOKEN=REPLACE_WITH_CLUSTER_TOKEN
TAILSCALE_AUTHKEY=REPLACE_WITH_YOUR_TAILSCALE_AUTHKEY

# =======================
# KUBELET CONFIGURATION
# =======================

# Resource reservations for system and Kubernetes components
# This node is the control plane with 4 CPUs and 8GB RAM
# Runs: K3s server, Jellyfin, Nextcloud, *arr stack, Traefik, etc.
# CPU: Reserving 2 cores (1 system + 1 K8s) out of 4 cores via CPU pinning
#      CPUs 0-1: Reserved for system (kubelet, etcd, containerd, OS, critical services)
#      CPUs 2-3: Available for pods (2 CPUs allocatable)
# Memory: Reserving 2.5GB total (2GB system + 500Mi K8s) out of 8GB
#         Leaves ~5.5GB allocatable for workloads
KUBELET_SYSTEM_RESERVED_CPU="1"
KUBELET_SYSTEM_RESERVED_MEMORY="2Gi"
KUBELET_KUBE_RESERVED_CPU="1"
KUBELET_KUBE_RESERVED_MEMORY="500Mi"

# CPU Manager Policy: static enables CPU pinning for Guaranteed QoS pods
# Reserved CPUs (system-reserved + kube-reserved = 2) are never allocated to pods
KUBELET_CPU_MANAGER_POLICY="static"
