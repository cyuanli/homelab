# Homelab Configuration for cyl-inspiron14
# Based on main homelab configuration

# =======================
# BASIC CONFIGURATION
# =======================

# Domain and networking
DOMAIN="cliff.li"
ACME_EMAIL="cyl@cliff.li"

# User configuration
HOMELAB_USER="cyl"
HOMELAB_UID="1000"
HOMELAB_GID="1000"

# =======================
# K3S CONFIGURATION
# =======================

# Node role and cluster info
NODE_ROLE=agent
CLUSTER_TOKEN=REPLACE_WITH_CLUSTER_TOKEN
SERVER_URL=REPLACE_WITH_SERVER_URL

# K3s version
K3S_VERSION="v1.28.8+k3s1"
KUBECTL_VERSION="v1.28.8"

# =======================
# TAILSCALE CONFIGURATION
# =======================

# Tailscale authentication key (REPLACE WITH YOUR OWN)
TAILSCALE_AUTHKEY="REPLACE_WITH_YOUR_TAILSCALE_AUTHKEY"

# =======================
# STORAGE CONFIGURATION
# =======================

# Storage configuration (inherited from main cluster)
DATA_ROOT="/media/data"
K8S_STORAGE_ROOT="/opt/k3s-storage"

# =======================
# SERVICE CONFIGURATION
# =======================

# Container user/group IDs
PUID="1000"
PGID="1000"
TIMEZONE="Etc/UTC"

# Feature flags
ENABLE_TRAEFIK_DASHBOARD="false"
ENABLE_LOCATION_SERVICES="false"
ENABLE_DISK_MONITORING="true"
ENABLE_BACKUP_MONITORING="true"

# =======================
# MONITORING & NOTIFICATIONS
# =======================


# =======================
# ADVANCED CONFIGURATION
# =======================

# UFW firewall configuration
ENABLE_UFW="true"
ALLOW_SSH_FROM_LAN="true"
LAN_CIDR="192.168.0.0/16"
